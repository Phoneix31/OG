# JSON-encoded Google service-account credentials. Never commit real credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=<json-encoded-service-account-credentials>

# Google Calendar identifier used by the application.
CALENDAR_ID=<google-calendar-id>

# Stripe credentials required by server.js.
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
